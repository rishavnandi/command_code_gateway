# Copy to vault.yml, fill in, then encrypt:
#
#   cp vault.yml.example vault.yml
#   openssl rand -hex 32          # for shared_secret
#   $EDITOR vault.yml
#   ansible-vault encrypt vault.yml
#
# vault.yml is gitignored. Losing the vault password means both Command Code
# accounts need a fresh browser login, because ~/.commandcode/auth.json only
# ever holds one key at a time.

vault_data:
  # Shared by all three hosts. It is what the router demands from opencode and
  # what it sends to each bridge. Generate with: openssl rand -hex 32
  #
  # The same string also goes into the opencode key file, so opencode can
  # authenticate. See README step 6.
  shared_secret: "REPLACE_WITH_RANDOM_HEX"

  # One Command Code key per bridge host. The names must match the hostnames in
  # inventory.yml exactly -- the template indexes by inventory_hostname, and a
  # typo here fails at render time rather than silently.
  #
  # Keys look like user_... and come from the browser login. Capture one at a
  # time: the next login overwrites the previous one on disk.
  cc_keys:
    heimdall: "REPLACE_WITH_USER_KEY"
    thor: "REPLACE_WITH_USER_KEY"
