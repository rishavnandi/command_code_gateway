# Rendered to mode 0600 with no_log. Never commit the output.
#
# HOST=0.0.0.0 plus compose's network_mode: host is what makes the port
# reachable over the tailnet without published-port rules.
HOST=0.0.0.0

BRIDGE_API_KEY={{ vault_data.shared_secret }}

COMMANDCODE_API_KEY={{ vault_data.cc_keys[inventory_hostname] }}

# Overrides the bridge's baked-in default, which is stale. Without this the
# bridge reports 1.74.0 while upstream expects 1.84.0 and answers with a 403
# that names a minVersion.
COMMANDCODE_CLI_VERSION={{ cc_cli_version }}

# Only 6 of the bridge's 85 bundled models are enabled by default; anything
# else is rejected with a 400. This extends that set. Comma separated, because
# the bridge parses it with a CSV reader.
COMMANDCODE_ALLOWED_MODELS={{ cc_allowed_models | join(',') }}
